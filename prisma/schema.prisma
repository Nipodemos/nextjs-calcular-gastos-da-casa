// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pessoa {
  id                         Int     @id @default(autoincrement())
  nome                       String  @unique
  porcentagemTaxaInss        Decimal
  porcentagemTaxaAlimentacao Decimal
  porcentagemTaxaPassagem    Decimal
  salario                    Decimal
  valorAlimentacao           Decimal
}

model Despesa {
  id        Int     @id @default(autoincrement())
  valor     Decimal
  descricao String  @unique
}
